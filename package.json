{
  "name": "security-route",
  "version": "1.0.0",
  "description": "Plataforma colaborativa de segurança urbana",
  "scripts": {
    "dev": "concurrently \"npx tsx server.ts > server.log 2>&1\" \"vite --port 3000\"",
    "build": "vite build && cp -r css icons js manifest.json sw.js dist/ 2>/dev/null || true",
    "start": "NODE_ENV=production npx tsx server.ts",
    "preview": "concurrently \"NODE_ENV=production npx tsx server.ts\" \"vite preview --port 3000\""
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "serve": "^14.2.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "vite-express": "^0.22.1"
  }
}
