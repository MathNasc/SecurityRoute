# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration (Oracle Cloud / Self-hosted)
DATABASE_URL=postgresql://securityroute_user:password@host:5435/securityroute_db

# Alternative individual connection parameters
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5435
DATABASE_NAME=securityroute_db
